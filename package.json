{
  "name": "portable-ai-preferences",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable AI Preferences — read validated assistant preferences from Sepolia ENS text records and steer an LLM safely. Road To Devcon VII, problem: Stop Making Me Explain Myself.",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "record": "tsx scripts/record-cases.ts",
    "ens:check": "tsx scripts/ens-check.ts",
    "check": "npm run typecheck && npm run test && npm run check:secrets",
    "harness:check": "node scripts/harness-check.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.37.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}