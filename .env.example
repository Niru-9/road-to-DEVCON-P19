# ---------------------------------------------------------------------------
# Portable AI Preferences — local configuration template.
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored and must never be committed. This file is tracked and
# must only ever contain placeholders like the ones below.
#
# Nothing in this file is a real credential.
#
# There is deliberately NO signing-key entry here, and there must never be one.
# Preference records are published by signing with the user's MetaMask wallet in the
# browser. This app never asks for, accepts, stores or transmits a private key or seed
# phrase, so there is nothing to put here.
#
# The two secrets below are ordinary API credentials, not wallet keys:
#   LLM_API_KEY      — a model-provider key, used server-side only
#   SEPOLIA_RPC_URL  — only a secret if you use a keyed/Pro RPC endpoint
# ---------------------------------------------------------------------------

# --- Model provider (any OpenAI-compatible API) -----------------------------
# The endpoint and model id are read from configuration, never hardcoded at the
# call site. Swap these three values to change provider without touching code.
# Examples:
#   Groq      LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama    LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=https://your-provider.example/v1

# Your provider's API key. Treat it as a secret: it stays server-side and is
# never sent to the browser, never printed, never committed.
LLM_API_KEY=replace-with-your-own-key

# Any model id your provider serves. Provider-specific, e.g. an OpenRouter
# model ending in `:free` for a free tier.
LLM_MODEL=replace-with-a-model-id

# Explicit timeout in milliseconds for every model request. Required: the model
# call is always bounded, so a hung free-tier request can never hang the app.
LLM_TIMEOUT_MS=20000

# --- Sepolia RPC ------------------------------------------------------------
# ENS text records are read from ENS on Sepolia through viem's Universal
# Resolver. A *public* endpoint is fine and is not a secret. A keyed/Pro RPC URL
# IS a secret — keep it in `.env` and never commit it.
#
# This credential is NOT a signing key. It grants read access to a node and cannot
# sign anything. All transactions are signed by MetaMask in the browser, which uses
# the wallet's own RPC — this value is only used by the server for reads.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Server -----------------------------------------------------------------
PORT=8787
# Set to "true" only for local experiments. Never enable in a public demo.
ALLOW_DEMO_FIXTURES=true